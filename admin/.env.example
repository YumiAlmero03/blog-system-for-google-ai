# Admin Authentication & Security
# Username for the super_user environment-configured admin account
ADMIN_USERNAME="admin"

# Password hash generated via PHP password_hash() (bcrypt or argon2id)
ADMIN_PASSWORD_HASH=""

# Secret key for signing admin session JWTs (falls back to BLOG_API_JWT_SECRET if unset)
ADMIN_JWT_SECRET=""

# Secret key for signing Blog API JWTs (64-char hex recommended)
BLOG_API_JWT_SECRET=""

# Application & URLs
# Optional version override; leave empty to auto-detect the current git commit hash on each push
APP_VERSION=""

# Public base URL of the site (used for sitemaps, canonicals, and indexing)
SITE_BASE_URL="http://localhost:8083/"

# Frontend application URL; if empty, falls back to SITE_BASE_URL / current site URL
FRONTEND_URL=""

# External Integrations
# SlotsLaunch API token for game imports
SLOTSLAUNCH_API_TOKEN=""

# SlotsLaunch origin domain
SLOTSLAUNCH_ORIGIN=""

# Sender email address for support tickets
TICKET_FROM_EMAIL=""

# Ollama API key for AI features
OLLAMA_API_KEY=""

# Google Search Console & Indexing API
# Path to private directory for Google credentials (outside web root)
GOOGLE_PRIVATE_DIR=""

# Enable direct URL submissions via Google Indexing API (true/false)
GOOGLE_INDEXING_ENABLED="false"

# Daily quota limit for Google Indexing API submissions (default: 200)
GOOGLE_INDEXING_DAILY_LIMIT="200"
