DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Plugin internals stay private, including nested sports storage helpers.
    RewriteRule ^admin/plugin/[^/]+/(?:.*/)?(?:includes|scripts)(?:/|$) - [F,L]
    RewriteRule ^admin/plugin/.*\.md$ - [F,L]
    RewriteRule ^admin/games/(.*)$ admin/plugin/games/$1 [L,QSA]
    RewriteRule ^admin/odds-api/(.*)$ admin/plugin/odds-api/$1 [L,QSA]
    RewriteRule ^admin/settings/sports/(.*)$ admin/plugin/odds-api/sports/$1 [L,QSA]
    RewriteRule ^admin/sports-livescore/(.*)$ admin/plugin/odds-api/livescore/$1 [L,QSA]
    RewriteRule ^odds-api/(.*\.(?:css|js))$ admin/plugin/odds-api/public/$1 [L]

    RewriteRule ^\.(?:git|gitignore|htaccess)(?:/|$) - [F,L]

    # Backend runtime/configuration is never served directly.
    RewriteRule ^admin/(?:includes|scripts|storage|chats|data|update-packages|\.github|\.vscode)(?:/|$) - [F,L]
    RewriteRule ^admin/games/(?:includes|scripts)(?:/|$) - [F,L]
    RewriteRule ^admin/sports-livescore/(?:includes|scripts)(?:/|$) - [F,L]
    RewriteRule ^admin/sports-livescore/.*\.md$ - [F,L]
    RewriteRule ^admin/odds-api/(?:includes|scripts)(?:/|$) - [F,L]
    RewriteRule ^admin/odds-api/.*\.md$ - [F,L]
    RewriteRule ^admin/(?:\.[^/]+|[^/]+\.(?:md|sh))$ - [F,L]

    # Preserve existing public upload URLs and root IndexNow verification URLs.
    RewriteCond %{DOCUMENT_ROOT}/admin/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ admin/uploads/$1 [L]
    RewriteCond %{DOCUMENT_ROOT}/admin/$1.txt -f
    RewriteRule ^([a-zA-Z0-9-]{8,128})\.txt$ admin/$1.txt [L]
    RewriteRule ^(login(?:-handler)?|logout)\.php$ admin/$1.php [L]

    RewriteRule ^game/([A-Za-z0-9-]+)/?$ /game/index.php?slug=$1 [L,QSA]
    RewriteRule ^games/([A-Za-z0-9-]+)/?$ /game/index.php?slug=$1 [L,QSA]
    RewriteRule ^blog/([A-Za-z0-9-]+)/?$ /blog/view.php?slug=$1 [L,QSA]
    RewriteRule ^blogs/([A-Za-z0-9-]+)/?$ /blog/view.php?slug=$1 [L,QSA]
    RewriteRule ^bonus/([A-Za-z0-9-]+)/?$ /bonus/index.php?code=$1 [L,QSA]
    RewriteRule ^promo-code/([A-Za-z0-9_-]{8,64})/?$ /promo-code/view.php?code=$1 [L,QSA]

    RewriteRule ^(app|invite|vip|payments|support|contact|blogs?)/?$ /index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(app|invite|vip|payments|support|contact|blogs?|games)(/.*)?$ /index.html [L]
</IfModule>
